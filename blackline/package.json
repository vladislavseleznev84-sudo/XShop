{
  "name": "blackline-barbershop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "BLACKLINE — демонстрационный сайт независимого барбершопа",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview --host",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e": "node e2e/smoke.mjs",
    "images:fetch": "node scripts/fetch-images.mjs",
    "images:build": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-serif-display": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.1",
    "jsdom": "^31.0.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
